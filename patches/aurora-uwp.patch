+static std::string TrimSpaces(std::string s) {
+  const auto not_space = [](unsigned char c) { return c != ' '; };
+  while (!s.empty() && !not_space(static_cast<unsigned char>(s.front()))) {
+    s.erase(s.begin());
+  }
+  while (!s.empty() && !not_space(static_cast<unsigned char>(s.back()))) {
