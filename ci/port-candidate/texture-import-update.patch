diff --git a/src/dusk/texture_pack_import.cpp b/src/dusk/texture_pack_import.cpp
new file mode 100644
index 0000000..548f194
--- /dev/null
+++ b/src/dusk/texture_pack_import.cpp
@@ -0,0 +1,178 @@
+#include "texture_pack_import.hpp"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <fstream>
+#include <limits>
+#include <string>
+#include <vector>
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace dusk::texture_packs {
+namespace {
+namespace fs = std::filesystem;
+struct File { fs::path relative; uint64_t bytes; };
+
+void check_cancel(const ImportProgress& progress) {
+    if (progress.cancel.load(std::memory_order_relaxed)) throw ImportCancelled{};
+}
+bool contains(const fs::path& parent, const fs::path& child) {
+    auto p = parent.begin(), c = child.begin();
+    for (; p != parent.end(); ++p, ++c) {
+        if (c == child.end()) return false;
+#if defined(_WIN32)
+        // Windows drive letters and path components are case-insensitive.
+        if (CompareStringOrdinal(p->c_str(), -1, c->c_str(), -1, TRUE) != CSTR_EQUAL) return false;
+#else
+        if (*p != *c) return false;
+#endif
+    }
+    return true;
+}
+bool texture_extension(const fs::path& path) {
+    auto ext = path.extension().u8string();
+    for (auto& ch : ext) if (ch >= u8'A' && ch <= u8'Z') ch = static_cast<char8_t>(ch + (u8'a' - u8'A'));
+    return ext == u8".png" || ext == u8".dds";
+}
+void validate_entry(const fs::path& path, const fs::path& source) {
+    if (fs::is_symlink(fs::symlink_status(path)) || !contains(source, fs::canonical(path))) {
+        throw std::runtime_error("Linked files/folders are not supported. Select an extracted texture pack without links.");
+    }
+}
+}  // namespace
+
+bool valid_pack_id(std::string_view id) noexcept {
+    if (!id.starts_with("pack-") || id.size() <= 5 || id.size() > 80) return false;
+    const auto separator = id.find('-', 5);
+    if (separator == std::string_view::npos || separator == 5 || separator + 1 == id.size()) return false;
+    auto digits = [](std::string_view value) {
+        return std::all_of(value.begin(), value.end(), [](char c) { return c >= '0' && c <= '9'; });
+    };
+    return digits(id.substr(5, separator - 5)) && digits(id.substr(separator + 1));
+}
+
+fs::path resolve_directory(const fs::path& dataRoot, std::string_view id) {
+    if (valid_pack_id(id)) {
+        const auto selected = dataRoot / "texture_packs" / std::string{id};
+        std::error_code ec;
+        if (fs::is_directory(selected, ec) && !fs::is_symlink(fs::symlink_status(selected, ec))) return selected;
+    }
+    return dataRoot / "texture_replacements";
+}
+
+ImportResult import_directory(const fs::path& sourcePath, const fs::path& managedRoot,
+    ImportProgress& progress, const TextureNameValidator& isReplacement) {
+    fs::path staging;
+    bool ownsStaging = false;
+    try {
+        progress.phase = ImportPhase::Scanning;
+        progress.totalFiles = 0; progress.totalBytes = 0;
+        progress.copiedFiles = 0; progress.copiedBytes = 0;
+        check_cancel(progress);
+        if (!isReplacement) throw std::runtime_error("A texture filename validator is required.");
+        if (fs::is_symlink(fs::symlink_status(sourcePath))) {
+            throw std::runtime_error("Select the real texture pack folder, not a linked folder.");
+        }
+        const auto source = fs::canonical(sourcePath);
+        if (!fs::is_directory(source) || source.relative_path().empty()) {
+            throw std::runtime_error("Select an extracted texture pack folder, not a USB drive root or ZIP file.");
+        }
+        const auto destination = fs::weakly_canonical(fs::absolute(managedRoot));
+        if (contains(source, destination) || contains(destination, source)) {
+            throw std::runtime_error("The source must be outside the app's managed texture_packs folder.");
+        }
+
+        std::vector<File> files;
+        uint64_t total = 0, replacements = 0;
+        // Deliberately do not follow links or skip access errors: an incomplete
+        // USB scan must fail without changing the active pack.
+        for (fs::recursive_directory_iterator it(source), end; it != end; ++it) {
+            check_cancel(progress);
+            if (it.depth() > 64) throw std::runtime_error("Texture pack folders are nested too deeply.");
+            validate_entry(it->path(), source);
+            const auto status = it->symlink_status();
+            if (fs::is_directory(status)) continue;
+            if (!fs::is_regular_file(status)) throw std::runtime_error("The texture pack contains an unsupported file type.");
+            if (!texture_extension(it->path())) continue;
+            if (files.size() >= 200'000) throw std::runtime_error("This texture pack contains too many files (limit: 200,000).");
+            const auto size = it->file_size();
+            if (size > std::numeric_limits<uint64_t>::max() - total) throw std::runtime_error("Texture pack size overflow.");
+            total += size;
+            files.push_back({it->path().lexically_relative(source), size});
+            if (isReplacement(it->path())) ++replacements;
+            progress.totalFiles = files.size(); progress.totalBytes = total;
+        }
+        if (!replacements) {
+            throw std::runtime_error("No supported texture replacements found. Extract the pack first and select the folder containing tex1_*.png or tex1_*.dds files (subfolders are included).");
+        }
+        check_cancel(progress);
+        fs::create_directories(destination);
+        const auto available = fs::space(destination).available;
+        constexpr uint64_t margin = 8 * 1024 * 1024;
+        if (total > available || available - total < margin) {
+            throw std::runtime_error("Not enough free app storage. The whole pack must fit, plus 8 MiB of free space; existing packs are kept.");
+        }
+
+        static std::atomic<uint64_t> sequence{0};
+        fs::path final;
+        for (unsigned attempt = 0; attempt != 100; ++attempt) {
+            const auto tick = static_cast<uint64_t>(std::chrono::steady_clock::now().time_since_epoch().count());
+            const auto suffix = std::to_string(tick) + "-" + std::to_string(sequence++);
+            staging = destination / (".import-" + suffix);
+            final = destination / ("pack-" + suffix);
+            if (fs::exists(final)) continue;
+            if (fs::create_directory(staging)) { ownsStaging = true; break; }
+        }
+        if (!ownsStaging) throw std::runtime_error("Cannot create a temporary texture pack folder.");
+        progress.phase = ImportPhase::Copying;
+        std::array<char, 256 * 1024> buffer{};
+        for (const auto& file : files) {
+            check_cancel(progress);
+            const auto inputPath = source / file.relative;
+            validate_entry(inputPath, source);
+            if (!fs::is_regular_file(inputPath) || fs::file_size(inputPath) != file.bytes) {
+                throw std::runtime_error("The USB pack changed during import. Keep it connected and try again.");
+            }
+            const auto outputPath = staging / file.relative;
+            fs::create_directories(outputPath.parent_path());
+            std::ifstream input(inputPath, std::ios::binary);
+            if (!input) throw std::runtime_error("Cannot read a texture file. Check USB access and keep the drive connected.");
+            std::ofstream output;
+            output.exceptions(std::ios::badbit | std::ios::failbit);
+            output.open(outputPath, std::ios::binary | std::ios::trunc);
+            uint64_t copied = 0;
+            while (input) {
+                check_cancel(progress);
+                input.read(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+                const auto count = input.gcount();
+                if (count > 0) {
+                    copied += static_cast<uint64_t>(count);
+                    if (copied > file.bytes) throw std::runtime_error("A texture file changed during import. Try again.");
+                    output.write(buffer.data(), count);
+                    progress.copiedBytes.fetch_add(static_cast<uint64_t>(count), std::memory_order_relaxed);
+                }
+            }
+            if (!input.eof() || copied != file.bytes) throw std::runtime_error("USB read failed or a texture file changed. The previous pack is unchanged.");
+            output.flush(); output.close();
+            ++progress.copiedFiles;
+        }
+        check_cancel(progress);
+        // Only complete packs get selectable IDs. A crash during copy leaves an
+        // unselected .import-* directory, never a partially activated pack.
+        fs::rename(staging, final);
+        ownsStaging = false;
+        progress.phase = ImportPhase::Complete;
+        return {final, static_cast<uint64_t>(files.size()), total};
+    } catch (...) {
+        if (ownsStaging) { std::error_code ignored; fs::remove_all(staging, ignored); }
+        progress.phase = progress.cancel.load() ? ImportPhase::Cancelled : ImportPhase::Failed;
+        throw;
+    }
+}
+}  // namespace dusk::texture_packs
diff --git a/src/dusk/texture_pack_import.hpp b/src/dusk/texture_pack_import.hpp
new file mode 100644
