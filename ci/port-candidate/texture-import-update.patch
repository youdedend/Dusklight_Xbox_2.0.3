diff --git a/tests/uwp/texture_pack_import_test.cpp b/tests/uwp/texture_pack_import_test.cpp
new file mode 100644
index 0000000..31ebf62
--- /dev/null
+++ b/tests/uwp/texture_pack_import_test.cpp
@@ -0,0 +1,148 @@
+#include "dusk/texture_pack_import.hpp"
+#include <cassert>
+#include <chrono>
+#include <fstream>
+#include <iostream>
+#include <thread>
+#include <string>
+
+namespace fs = std::filesystem;
+namespace packs = dusk::texture_packs;
+namespace {
+void write(const fs::path& path, std::string_view data) {
+    fs::create_directories(path.parent_path());
+    std::ofstream out(path, std::ios::binary); out << data;
+    assert(out.good());
+}
+std::string read(const fs::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    return {std::istreambuf_iterator<char>{in}, std::istreambuf_iterator<char>{}};
+}
+bool valid(const fs::path& path) { return path.filename().string().starts_with("tex1_"); }
+template <class F> void fails(F&& call) {
+    bool failed = false;
+    try { call(); } catch (const std::exception&) { failed = true; }
+    assert(failed);
+}
+size_t entries(const fs::path& path) {
+    if (!fs::exists(path)) return 0;
+    return static_cast<size_t>(std::distance(fs::directory_iterator(path), fs::directory_iterator{}));
+}
+}
+int main() {
+    const auto root = fs::temp_directory_path() /
+        ("dusk-pack-test-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    struct Cleanup { fs::path path; ~Cleanup() { std::error_code ec; fs::remove_all(path, ec); } } cleanup{root};
+    const auto source = root / "USB" / fs::path{u8"HD pack café"};
+    const auto data = root / "LocalState";
+    const auto managed = data / "texture_packs";
+    const auto texture = "tex1_64x64_0123456789abcdef_0.png";
+    write(source / "nested" / texture, "texture-one");
+    write(source / "nested" / "tex1_32x32_123456789abcdef0_0.DDS", "texture-two");
+    write(source / "elsewhere" / texture, "same-name-other-folder");
+    write(source / "README.txt", "documentation is not imported");
+    write(source / "unrelated.zip", "not imported");
+    write(data / "texture_replacements" / "manual.png", "keep my manual pack");
+    packs::ImportProgress progress;
+    const auto result = packs::import_directory(source, managed, progress, valid);
+    assert(result.files == 3 && result.bytes == 44);
+    assert(progress.copiedBytes == result.bytes && progress.copiedFiles == 3);
+    assert(progress.phase == packs::ImportPhase::Complete);
+    assert(read(result.directory / "nested" / texture) == "texture-one");
+    assert(read(result.directory / "elsewhere" / texture) == "same-name-other-folder");
+    assert(!fs::exists(result.directory / "README.txt"));
+    assert(read(source / "nested" / texture) == "texture-one");
+    assert(read(data / "texture_replacements" / "manual.png") == "keep my manual pack");
+    const auto id = result.directory.filename().string();
+    assert(packs::valid_pack_id(id));
+    assert(packs::resolve_directory(data, id) == result.directory);
+    for (const auto* bad : {"../escape", "pack-../x", "pack-1/2", "pack--", "pack-1-2-3", "pack-", "pack-123", ""}) {
+        assert(!packs::valid_pack_id(bad));
+        assert(packs::resolve_directory(data, bad) == data / "texture_replacements");
+    }
+    assert(packs::resolve_directory(data, "pack-1-9999") == data / "texture_replacements");
+
+    // A second import is isolated; no existing pack or manual file is removed.
+    packs::ImportProgress again;
+    const auto second = packs::import_directory(source, managed, again, valid);
+    assert(second.directory != result.directory && entries(managed) == 2);
+    assert(read(result.directory / "nested" / texture) == "texture-one");
+
+    const auto empty = root / "empty";
+    write(empty / "photo.png", "not a replacement filename");
+    packs::ImportProgress invalid;
+    fails([&] { packs::import_directory(empty, managed, invalid, valid); });
+    assert(entries(managed) == 2);
+    fails([&] { packs::import_directory(root / "missing", managed, invalid, valid); });
+    fails([&] { packs::import_directory(source, source / "descendant", invalid, valid); });
+    fails([&] { packs::import_directory(result.directory, managed, invalid, valid); });
+    fails([&] { packs::import_directory(fs::current_path().root_path(), managed, invalid, valid); });
+    fails([&] { packs::import_directory(source, managed, invalid, {}); });
+
+    packs::ImportProgress cancelled;
+    cancelled.cancel = true;
+    fails([&] { packs::import_directory(source, managed, cancelled, valid); });
+    assert(cancelled.phase == packs::ImportPhase::Cancelled && entries(managed) == 2);
+    packs::ImportProgress scanning;
+    fails([&] { packs::import_directory(source, managed, scanning, [&](const fs::path&) {
+        scanning.cancel = true; return true;
+    }); });
+    assert(scanning.phase == packs::ImportPhase::Cancelled && entries(managed) == 2);
+
+    // USB source changed after its scan: fail and clean staging, keep old pack.
+    const auto changing = root / "changing";
+    write(changing / texture, "original-data");
+    packs::ImportProgress changed;
+    fails([&] { packs::import_directory(changing, managed, changed, [&](const fs::path& file) {
+        write(file, "x"); return true;
+    }); });
+    assert(changed.phase == packs::ImportPhase::Failed && entries(managed) == 2);
+
+    // Linked files/directories are not followed, even when targets are internal.
+    const auto linked = root / "linked";
+    write(linked / texture, "original");
+    std::error_code ec;
+    fs::create_symlink(source / "nested" / texture, linked / "alias.png", ec);
+    if (!ec) {
+        packs::ImportProgress links;
+        fails([&] { packs::import_directory(linked, managed, links, valid); });
+        assert(entries(managed) == 2);
+    }
+    fs::remove(linked / "alias.png", ec);
+    fs::create_directory_symlink(source, linked / "linked-folder", ec);
+    if (!ec) {
+        packs::ImportProgress links;
+        fails([&] { packs::import_directory(linked, managed, links, valid); });
+        assert(entries(managed) == 2);
+    }
+
+    // Cancel a real chunked copy rather than only cancelling before it starts.
+    const auto large = root / "large";
+    write(large / texture, "x");
+    fs::resize_file(large / texture, 256ULL * 1024 * 1024);
+    packs::ImportProgress copying;
+    std::atomic<bool> finished{false}, caughtCancel{false};
+    std::jthread worker([&] {
+        try { packs::import_directory(large, managed, copying, valid); }
+        catch (const packs::ImportCancelled&) { caughtCancel = true; }
+        catch (const std::exception&) { assert(false && "unexpected copy failure"); }
+        finished = true;
+    });
+    while (!copying.copiedBytes.load() && !finished.load()) std::this_thread::yield();
+    copying.cancel = true;
+    worker.join();
+    assert(caughtCancel && copying.phase == packs::ImportPhase::Cancelled);
+    assert(entries(managed) == 2);
+
+#if !defined(_WIN32)
+    // Sparse logical size permits a deterministic free-space failure without
+    // allocating the full data. Windows' resize behavior is intentionally skipped.
+    const auto huge = root / "huge";
+    write(huge / texture, "x");
+    fs::resize_file(huge / texture, fs::space(managed).available + 16ULL * 1024 * 1024);
+    packs::ImportProgress space;
+    fails([&] { packs::import_directory(huge, managed, space, valid); });
+    assert(space.phase == packs::ImportPhase::Failed && entries(managed) == 2);
+#endif
+    std::cout << "PASS: nested/Unicode import, progress, persistent selection paths, non-destructive repeat import, invalid packs, overlap/root/ID rejection, scan/copy cancellation, USB changes, links, cleanup and storage preflight.\n";
+}
