+#include <borealis/io.hpp>
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <string>
+#include <thread>
+#include <utility>
+
+namespace dusk::ui {
+namespace {
+namespace packs = texture_packs;
+
+void show_message(std::string title, std::string message) {
+    push_document(std::make_unique<Modal>(Modal::Props{
+        .title = std::move(title), .bodyText = std::move(message),
+        .actions = {{.label = "OK", .onPressed = [](Modal& modal) { modal.pop(); }}},
+    }));
+}
+
+// A completed, inactive import is selected only on the UI/render thread.
+// Existing texture_replacements files and prior imported packs are never erased.
+void activate_pack(const std::string& id, bool enable) {
+    auto& settings = getSettings();
+    const auto previous = settings.backend.importedTexturePack.getValue();
+    const bool previousEnable = settings.game.enableTextureReplacements.getValue();
+    try {
+        settings.backend.importedTexturePack.setValue(id);
+        settings.game.enableTextureReplacements.setValue(enable);
+        // A changed enable switch already reloads through its config callback.
+        if (previousEnable == enable) texture_replacements::reload();
+        if (!config::save_checked()) throw std::runtime_error("Could not save the pack selection to app storage.");
+    } catch (...) {
+        const bool currentEnable = settings.game.enableTextureReplacements.getValue();
+        settings.backend.importedTexturePack.setValue(previous);
+        settings.game.enableTextureReplacements.setValue(previousEnable);
+        if (currentEnable == previousEnable) texture_replacements::reload();
+        throw;
+    }
+}
+
+struct ImportState {
+    packs::ImportProgress progress;
+    packs::ImportResult result;
+    std::string error;
+    bool cancelled = false;
+    std::atomic<bool> done{false}; // publishes result/error to the UI thread
+};
+
+class ImportWindow final : public Modal {
+public:
+    explicit ImportWindow(std::filesystem::path source)
+        : Modal(Props{
+            .title = "Import Texture Pack",
+            .bodyText = "Scanning the selected pack. Keep the USB drive connected.",
+            .actions = {
+                {.label = "Cancel", .onPressed = [this](Modal&) { mState->progress.cancel = true; },
+                 .isDisabled = [this] { return mFinished || mState->progress.cancel.load(); }},
+                {.label = "Close", .onPressed = [](Modal& modal) { modal.pop(); },
+                 .isDisabled = [this] { return !mFinished; }},
+            },
+            .onDismiss = [this](Modal& modal) {
+                if (mFinished) modal.pop();
+                else mState->progress.cancel = true;
+            },
+        }), mState(std::make_shared<ImportState>()) {
+        // No settings, RmlUi or renderer access occurs on the worker thread.
+        mWorker = std::jthread([state = mState, source = std::move(source), root = ConfigPath / "texture_packs"] {
+            try {
+                state->result = packs::import_directory(source, root, state->progress,
+                    [](const std::filesystem::path& file) {
+                        return aurora::texture::parse_replacement_filename(
+                            borealis::io::fs_path_to_string(file.filename())).has_value();
+                    });
+            } catch (const packs::ImportCancelled& e) {
+                state->cancelled = true; state->error = e.what();
+            } catch (const std::exception& e) {
+                state->error = e.what();
+            } catch (...) {
+                state->error = "An unexpected error interrupted the import.";
+            }
+            state->done.store(true, std::memory_order_release);
+        });
+    }
+    ~ImportWindow() override {
+        mState->progress.cancel = true;
+        if (mWorker.joinable()) mWorker.join();
+    }
+    void update() override {
+        Modal::update();
+        if (mFinished) return;
+        if (mState->done.load(std::memory_order_acquire)) {
+            if (mWorker.joinable()) mWorker.join();
+            if (!mState->error.empty()) {
+                set_body_text((mState->cancelled ? "Import cancelled.\n" : "Import failed.\n") +
+                    mState->error + "\nYour previous pack and manually installed textures are unchanged.");
+            } else if (mState->progress.cancel.load()) {
+                // Cancellation may race with completion. The finished copy is
+                // retained but never activated; no previous pack is replaced.
+                set_body_text("Import cancelled. The completed copy was not activated. Your previous pack is unchanged.");
+            } else {
+                try {
+                    activate_pack(mState->result.directory.filename().string(), true);
+                    set_body_text(fmt::format(
+                        "Texture pack imported and enabled: {} files ({}).\n"
+                        "You can now disconnect the USB drive. The selection is saved for next launch.\n"
+                        "Your manual texture folder and earlier imports are kept. Restart the game if a texture has not refreshed.",
+                        mState->result.files, format_bytes(mState->result.bytes)));
+                } catch (const std::exception& e) {
+                    set_body_text(std::string{"The pack was copied but could not be activated. The previous selection was restored.\n"} + e.what());
+                }
+            }
+            mFinished = true;
+            focus();
+            return;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now - mLastUpdate < std::chrono::milliseconds(200)) return;
+        mLastUpdate = now;
+        if (mState->progress.cancel.load()) {
+            set_body_text("Cancelling the import and removing temporary files. Please keep the USB drive connected until this finishes.");
+        } else if (mState->progress.phase.load() == packs::ImportPhase::Copying) {
+            set_body_text(fmt::format("Copying: {} / {} files\n{} / {}\nKeep the USB drive connected. Your previous pack stays active until the import completes.",
+                mState->progress.copiedFiles.load(), mState->progress.totalFiles.load(),
+                format_bytes(mState->progress.copiedBytes.load()), format_bytes(mState->progress.totalBytes.load())));
+        } else {
+            set_body_text(fmt::format("Scanning the selected pack: {} texture files found ({}).\nKeep the USB drive connected. Press Cancel to stop.",
+                mState->progress.totalFiles.load(), format_bytes(mState->progress.totalBytes.load())));
+        }
+    }
+private:
+    std::shared_ptr<ImportState> mState;
+    std::jthread mWorker;
+    std::chrono::steady_clock::time_point mLastUpdate{};
+    bool mFinished = false;
+};
+
+void choose_pack_folder() {
+    file_select::open_folder({.requireRealPath = true}, [](file_select::Result result) {
+        if (result.status == file_select::Status::Canceled) return;
+        if (result.status != file_select::Status::Selected || result.locations.empty()) {
+            show_message("Texture Pack Not Selected", result.message.empty() ? "Could not open the folder browser. Try again." : result.message);
+            return;
+        }
+        const auto source = borealis::io::fs_path_from_utf8(result.locations.front());
+        push_document(std::make_unique<Modal>(Modal::Props{
+            .title = "Import This Texture Pack?",
+            .bodyText = "Selected folder:\n" + borealis::io::fs_path_to_string(source) +
+                "\nPNG/DDS texture files and their subfolders will be copied into app storage and enabled. "
+                "Keep the USB drive connected until the import finishes. ZIP files must be extracted first. "
+                "Existing manual textures and earlier imports are kept, so enough free app storage is required.",
+            .actions = {
+                {.label = "Import", .onPressed = [source](Modal& modal) {
+                    modal.pop();
+                    try { push_document(std::make_unique<ImportWindow>(source)); }
+                    catch (const std::exception& e) { show_message("Cannot Start Import", e.what()); }
+                }},
+                {.label = "Cancel", .onPressed = [](Modal& modal) { modal.pop(); }},
+            },
+        }));
+    });
+}
+}  // namespace
+
+void build_texture_pack_control(Pane& left, Pane& right) {
+    left.register_control(left.add_select_button({
+        .key = "Texture Pack",
+        .getValue = [] {
+            return packs::resolve_directory(ConfigPath, getSettings().backend.importedTexturePack.getValue()) ==
+                ConfigPath / "texture_replacements" ? "Default Folder" : "Imported Pack";
+        },
+    }), right, [](Pane& pane) {
+        pane.add_text("Import an extracted texture pack folder from USB. Use the drive list to choose your USB drive, then select the pack folder and choose 'Use this folder'. Only PNG/DDS replacements are imported; ZIP files are not supported.");
+        pane.add_button("Import Texture Pack from USB...").on_pressed(&choose_pack_folder);
+        pane.add_button("Use Default Texture Folder").on_pressed([] {
+            try {
+                activate_pack({}, true);
+                show_message("Default Texture Folder Selected", "The original texture_replacements folder is active again. Imported packs have not been deleted.");
+            } catch (const std::exception& e) { show_message("Could Not Change Texture Pack", e.what()); }
+        });
+        pane.add_text("The USB source is never changed. Imported packs are stored under texture_packs in app data and are kept as backups; repeated imports use additional storage. You can still use the Enable Texture Replacements switch above.");
+    });
+}
+}  // namespace dusk::ui
+#endif
