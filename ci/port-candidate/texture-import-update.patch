--- /dev/null
+++ b/src/dusk/texture_pack_import.hpp
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <stdexcept>
+#include <string_view>
+
+namespace dusk::texture_packs {
+
+enum class ImportPhase { Scanning, Copying, Complete, Cancelled, Failed };
+struct ImportProgress {
+    std::atomic<bool> cancel{false};
+    std::atomic<ImportPhase> phase{ImportPhase::Scanning};
+    std::atomic<uint64_t> totalFiles{0}, totalBytes{0}, copiedFiles{0}, copiedBytes{0};
+};
+struct ImportResult {
+    std::filesystem::path directory;
+    uint64_t files = 0, bytes = 0;
+};
+class ImportCancelled final : public std::runtime_error {
+public:
+    ImportCancelled() : std::runtime_error("Texture pack import cancelled. The previous pack is unchanged.") {}
+};
+using TextureNameValidator = std::function<bool(const std::filesystem::path&)>;
+
+// Copies PNG/DDS files into a new, privately staged directory, then renames it
+// into place. Does not modify the USB source, existing packs, or game settings.
+// Throws on failure/cancel; only staging data created by this call is removed.
+ImportResult import_directory(const std::filesystem::path& source,
+    const std::filesystem::path& managedRoot, ImportProgress& progress,
+    const TextureNameValidator& isReplacement);
+
+bool valid_pack_id(std::string_view id) noexcept;
+// Invalid/missing selections fall back to the existing manual-install folder.
+std::filesystem::path resolve_directory(const std::filesystem::path& dataRoot, std::string_view id);
+
+}  // namespace dusk::texture_packs
